# Copy to .env.local and fill in. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
JWT_SECRET=generate-with-node-crypto-randomBytes-32-hex

# Copy the same file to .env.test for the test suite.
# MUST be a different, empty Postgres database (tests insert rows).
TEST_DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/apparelflow_test